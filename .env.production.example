# YuktiOps production environment. Copy to /opt/yuktiops/.env.production on the server, chmod 600,
# replace every CHANGE_ME. NEVER commit the real file. Generate secrets with:
#   openssl rand -hex 24        # passwords / tokens (hex is URL-safe: the DB password goes in a URL)
#   openssl rand -hex 32        # BILLING_WEBHOOK_SECRET, PGBACKREST_CIPHER_PASS
# Keep a copy of PGBACKREST_CIPHER_PASS in your password manager: without it the backups are unreadable.
#
# This file mirrors backend/src/config.js. If a new variable is added there, add it here (and to the
# `x-app-env` block in docker-compose.prod.yml, which is the only place the containers read it from).

# ---- Public addresses (config.js: APP_URL, API_PUBLIC_URL; both must be https in production) ------
# Bare host names; docker-compose.prod.yml builds APP_URL=https://$APP_DOMAIN and API_PUBLIC_URL=https://$API_DOMAIN.
APP_DOMAIN=app.yuktiops.com
API_DOMAIN=api.yuktiops.com
# Let's Encrypt registration/expiry notices.
ACME_EMAIL=ops@yuktiops.com

# ---- Process (config.js: NODE_ENV, PORT) ------------------------------------------------------------
# NODE_ENV=production and PORT=4000 are fixed by docker-compose.prod.yml; do not set them here.

# ---- Reverse proxy trust (config.js: TRUST_PROXY) ----------------------------------------------------
# Express "trust proxy": which peers may set X-Forwarded-For. Must name exactly the Caddy network or every
# rate limit sees one IP (or can be spoofed). The default is the "edge" subnet defined in docker-compose.prod.yml.
TRUST_PROXY=172.29.0.0/24

# ---- Database (config.js: DATABASE_URL, built by compose from these three) -------------------------
POSTGRES_USER=yuktiops
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=yuktiops
# Prisma pool per process, to PgBouncer (every api replica and worker role gets this many client connections).
DB_POOL_SIZE=10
# Real Postgres connections PgBouncer keeps open (transaction pooling). Keep it well below max_connections (100).
PGBOUNCER_POOL_SIZE=40
# api replicas behind Caddy (stateless). Raise with CPU; see docs/ops.md "Scaling out".
API_REPLICAS=2
# Migrations bypass PgBouncer: docker-compose.prod.yml builds DIRECT_DATABASE_URL (db:5432) and deploy.sh uses it.

# ---- Redis (config.js: REDIS_URL, built by compose from the password; required) --------------------
# Rate limits, lockouts, the agent cache, queues. No public port. Use a long random password.
REDIS_PASSWORD=CHANGE_ME

# ---- Internal observability (backend/src/routes/metrics-internal.js; never routed by Caddy) -----------------
# GET /metrics (Prometheus) requires this bearer token. openssl rand -hex 24. Empty = loopback-only access.
METRICS_TOKEN=CHANGE_ME
# Bull Board at /admin/queues (staff only, basic auth). Leave both empty to disable it.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
# Ingest backpressure: answer 503 when this many jobs wait, or the oldest waits this long.
# INGEST_MAX_WAITING=50000
# INGEST_MAX_LAG_SECONDS=60
# Optional dead-man's switch ping for deploy/backup/redis-snapshot.sh
# REDIS_BACKUP_PING_URL=

# ---- Billing (config.js: BILLING_PROVIDER, BILLING_WEBHOOK_SECRET) ----------------------------------
# Free beta uses the mock provider. The secret must not contain dummy/change-me/example/local (checked at boot).
BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=CHANGE_ME

# ---- Email (config.js: EMAIL_PROVIDER, EMAIL_FROM, SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD) ----
# "smtp" sends real mail; "local" only logs it (never use local in production). Any SMTP relay works
# (Amazon SES, Postmark, Resend, Brevo...). SPF, DKIM and DMARC records must exist for the EMAIL_FROM domain.
EMAIL_PROVIDER=smtp
EMAIL_FROM=alerts@yuktiops.com
SMTP_HOST=CHANGE_ME_smtp.example-provider.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# ---- Worker (config.js: WORKER_INTERVAL_MS) ------------------------------------------------------------
WORKER_INTERVAL_MS=30000

# ---- Images / releases (read by docker-compose.prod.yml and deploy/deploy.sh) --------------------------
# deploy.sh sets APP_TAG per release (git short SHA). Leave unset by hand unless rolling back manually.
# APP_IMAGE=ghcr.io/CHANGE_ME/yuktiops-app     # optional: pull prebuilt images instead of building on the VM
# WEB_IMAGE=ghcr.io/CHANGE_ME/yuktiops-web
# APP_TAG=latest

# ---- Backups: pgBackRest -> Cloudflare R2 (deploy/backup/*) ------------------------------------------------
BACKUP_REPO_TYPE=s3
# Account endpoint, e.g. 0123456789abcdef.r2.cloudflarestorage.com (no https://)
R2_ENDPOINT=CHANGE_ME.r2.cloudflarestorage.com
R2_BUCKET=yuktiops-pgbackrest
# R2 API token with Object Read & Write on that one bucket only.
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
PGBACKREST_CIPHER_PASS=CHANGE_ME
# healthchecks.io check URL (period 1 day, grace 2 hours). backup.sh pings it on success, /start and /fail.
# BACKUP_PING_URL=https://hc-ping.com/CHANGE_ME

# ---- Deploy script knobs (deploy/deploy.sh) ------------------------------------------------------------------
# Public URLs hit by the post-deploy smoke test.
HEALTH_URL_API=https://api.yuktiops.com/api/health
HEALTH_URL_APP=https://app.yuktiops.com/
# Where our own monitoring pings after a successful deploy / on failure (optional, e.g. healthchecks.io).
# DEPLOY_NOTIFY_URL=
