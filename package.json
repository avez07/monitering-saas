{
  "name": "yuktiops",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend",
    "site"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"npm run dev -w backend\" \"npm run worker:dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:worker": "npm run worker:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:all": "concurrently -k -n api,worker,web -c blue,magenta,green \"npm run dev:backend\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "dev:terminals": "node scripts/dev-terminals.mjs",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "test:e2e": "playwright test",
    "format": "prettier --write frontend/src frontend/vite.config.js backend/src backend/scripts backend/test e2e *.json *.js *.yml *.md --ignore-unknown",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "agent": "node backend/scripts/agent.mjs",
    "agent:build": "node agent/scripts/dist.mjs --host",
    "agent:dist": "node agent/scripts/dist.mjs",
    "agent:test": "node agent/scripts/dist.mjs --test",
    "check": "npm test && npm run build && npm run db:validate -w backend",
    "worker": "npm run worker -w backend",
    "loadtest": "node deploy/loadtest/loadtest.mjs",
    "deploy:release": "bash deploy/deploy.sh",
    "deploy:rollback": "bash deploy/rollback.sh",
    "deploy:backup-check": "bash deploy/backup/check.sh",
    "site:dev": "npm run dev -w site",
    "site:build": "npm run build -w site"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "deepmerge-ts": "^8.0.2",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "deepmerge-ts": "$deepmerge-ts"
  }
}
