---
import { NAV, REGISTER_URL, LOGIN_URL } from '../site.js';
const path = Astro.url.pathname;
const active = (href) => path === href || path.startsWith(href + '/');
---
<header class="sticky top-0 z-40 border-b bg-background/95 backdrop-blur">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
      <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true" class="text-foreground"><rect width="32" height="32" rx="7" fill="currentColor" /><path d="M5 17h5l3-8 5 15 3-7h6" fill="none" class="stroke-background" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      YuktiOps
    </a>
    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {NAV.map((n) => (
        <a href={n.href} aria-current={active(n.href) ? 'page' : undefined} class:list={['rounded-md px-3 py-2 text-sm font-medium hover:bg-accent', active(n.href) ? 'bg-accent' : 'text-muted-foreground hover:text-accent-foreground']}>{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <button id="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" class="inline-flex h-9 w-9 items-center justify-center rounded-md border hover:bg-accent">
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <a href={LOGIN_URL} class="hidden px-3 text-sm font-medium text-muted-foreground hover:text-foreground sm:inline">Sign in</a>
      <a href={REGISTER_URL} class="btn-primary hidden sm:inline-flex">Start free</a>
      <button id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu" class="inline-flex h-9 w-9 items-center justify-center rounded-md border hover:bg-accent md:hidden">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" aria-label="Mobile" class="hidden border-t md:hidden">
    <div class="wrap flex flex-col gap-1 py-3">
      {NAV.map((n) => <a href={n.href} class="rounded-md px-3 py-2 text-sm font-medium hover:bg-accent">{n.label}</a>)}
      <a href={LOGIN_URL} class="rounded-md px-3 py-2 text-sm font-medium hover:bg-accent">Sign in</a>
      <a href={REGISTER_URL} class="btn-primary mt-1">Start free</a>
    </div>
  </nav>
</header>
