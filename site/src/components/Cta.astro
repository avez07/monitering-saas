---
import { REGISTER_URL } from '../site.js';
const { title = 'Know when something breaks, before your customers do.', text = 'Free plan, no credit card. Your first server is connected in about five minutes.' } = Astro.props;
---
<section class="section">
  <div class="wrap">
    <div class="card px-6 py-12 text-center sm:px-12">
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight">{title}</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted-foreground">{text}</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={REGISTER_URL} class="btn-primary">Start free</a>
        <a href="/docs/getting-started" class="btn-outline">Read the guide</a>
      </div>
    </div>
  </div>
</section>
