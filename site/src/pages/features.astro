---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';

const groups = [
  { id: 'servers', h: 'Servers', p: 'Install our small agent on a Linux server (VPS, cloud or your own machine).', items: ['CPU, memory, swap, disk per drive, disk activity, network per interface, load and uptime', 'The 10 busiest programs, so you can see what is using the machine', 'History from 7 days (Free) to 1 year (Business)', 'Clear status words: Healthy, Needs attention, Down, Waiting for data'] },
  { id: 'websites', h: 'Websites and APIs', p: 'Checked from the internet by our servers. No install, so it works on shared hosting too.', items: ['Is it up, and how fast does it answer', 'Look for a word on the page, or check an API for the right status code', 'SSL certificate and domain expiry warnings at 30, 14 and 7 days', 'Checks every 5 minutes (Free), every minute (paid) or every 30 seconds (Business)'] },
  { id: 'containers', h: 'Docker containers and services', p: 'See what runs on your servers, not only the servers themselves.', items: ['Per-container status, CPU and memory, with an alert when a container stops', 'Service checks for things like nginx, MySQL, Postgres and Redis, with an alert when one stops', 'Monitor Docker containers with no server install: run the agent as a container', 'Add a service from the dashboard in a few clicks'] },
  { id: 'apps', h: 'Apps (OpenTelemetry)', p: 'See traces and logs from your own applications, sent with the standard OpenTelemetry SDK or Collector.', items: ['Set a few OTEL_* environment variables and one telemetry key. No proprietary library in your app', 'Services list with request rate, error percent, p95 and a status word, plus a trace waterfall and a log explorer', 'Redaction rules remove sensitive attributes before storage, and sampling keeps volume down', 'Telemetry volume and retention depend on the plan: from 1 GB and 3 days (Free) to 250 GB and 30 days (Business). Metrics are accepted but not stored yet'] },
  { id: 'alerts', h: 'Alerts', p: 'Tell us what matters in plain words. We tell you when it happens.', items: ['One-click templates: server down, disk almost full, CPU very high, memory almost full, website down or slow, SSL or domain expiring', 'Send to email, Telegram, Slack, Discord or a signed webhook, with a Send test button', 'Alerts only fire after the problem lasts as long as you chose, so a short spike does not wake you up', 'New accounts start with three useful alerts already on'] },
  { id: 'team', h: 'Team', p: 'Share the dashboard without sharing your password.', items: ['Invite by email with a link that works once', 'Owner, Admin and Viewer roles', 'Remove anyone and their access ends'] },
  { id: 'help', h: 'Built-in help', p: 'Monitoring tools that cannot explain themselves are a pain.', items: ['A Connection page shows each setup step and what is wrong, in plain English', 'The agent has status and doctor commands that test your network, clock and permissions and tell you the fix', 'Everything is in our docs, written for non-technical readers'] },
];
---
<Base title="Features" description="Server health, website and API checks, SSL and domain expiry, simple alerts and team access. Everything small teams need to stay on top of their servers.">
  <section class="section">
    <div class="wrap">
      <h1 class="text-4xl font-bold tracking-tight">Features</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted-foreground">Everything you need to know when something breaks. Nothing that needs a training course.</p>
      <div class="mt-12 space-y-10">
        {groups.map((g) => (
          <section id={g.id} aria-labelledby={`${g.id}-h`} class="card p-6 sm:p-8">
            <h2 id={`${g.id}-h`} class="text-2xl font-semibold">{g.h}</h2>
            <p class="mt-2 text-muted-foreground">{g.p}</p>
            <ul class="mt-4 list-disc space-y-2 pl-6">{g.items.map((i) => <li>{i}</li>)}</ul>
          </section>
        ))}
      </div>
      <p class="mt-10 rounded-md border bg-muted p-4 text-sm"><strong>Coming later:</strong> native Windows and macOS agents and public status pages. (Docker Desktop on Windows and macOS works today, and monitors Docker's Linux VM.) We list only what exists or is clearly marked as planned.</p>
    </div>
  </section>
  <Cta />
</Base>
