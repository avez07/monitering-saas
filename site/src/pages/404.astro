---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <section class="section">
    <div class="wrap text-center">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight">We could not find that page</h1>
      <p class="mt-4 text-muted-foreground">It may have moved. Try the home page or the docs.</p>
      <div class="mt-6 flex justify-center gap-3">
        <a href="/" class="btn-primary">Home</a>
        <a href="/docs" class="btn-outline">Docs</a>
      </div>
    </div>
  </section>
</Base>
