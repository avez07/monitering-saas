---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { REGISTER_URL, SITE_URL } from '../site.js';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'YuktiOps',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux',
  url: SITE_URL,
  description: 'Simple, affordable server monitoring with uptime checks and alerts for small teams on a VPS or shared hosting.',
  offers: { '@type': 'AggregateOffer', lowPrice: '0', highPrice: '99', priceCurrency: 'USD' },
};

const steps = [
  ['1', 'Add a server', 'Create a free account and click Add server. Pick your system (Ubuntu, Debian, RHEL, Docker or other Linux).'],
  ['2', 'Run one command', 'Copy the command we show you and paste it into your server. It installs a tiny background program and connects it to your account.'],
  ['3', 'See your data', 'Within a minute you see CPU, memory, disk and network. Alerts go to your email or Telegram if something is wrong.'],
];
const features = [
  ['Server health at a glance', 'CPU, memory, disk, network, load and the busiest programs, with clear words like Healthy, Needs attention and Down.'],
  ['Website and API checks', 'We check your site from the internet every minute, including response time, SSL certificate and domain expiry. No install needed, so it works on shared hosting too.'],
  ['Alerts in plain language', 'Pick a template such as "Disk almost full" and choose where to send it: email, Telegram, Slack, Discord or a webhook.'],
  ['Know when a server goes silent', 'If a server stops reporting, we alert you from our side. Even if your own monitoring is down too.'],
  ['Your team, three roles', 'Invite teammates by email as Owner, Admin or Viewer. Remove them in one click.'],
  ['Honest troubleshooting', 'If data does not arrive, the dashboard tells you why and how to fix it in plain English. No guessing.'],
];
const promises = [
  ['No open ports', 'The agent only makes outbound HTTPS connections.'],
  ['Under 25 MB RAM', 'Hard-capped by the system service at 64 MB.'],
  ['Under 1% CPU', 'Capped at 10% of one core. It is a design target, not a hard promise for every machine.'],
  ['Read-only', 'It reads statistics. It never changes your server.'],
  ['Never runs remote commands', 'We cannot make your server run anything.'],
];
---
<Base
  title="YuktiOps: simple server monitoring for small teams"
  description="Know when your server or website has a problem. Simple, affordable monitoring and alerts for VPS and shared hosting. Free plan, set up in five minutes."
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="wrap text-center">
      <p class="eyebrow">Server and website monitoring for people who are not sysadmins</p>
      <h1 class="mx-auto mt-3 max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">Know when your server has a problem. Before your customers do.</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">YuktiOps watches your servers and websites and tells you in plain language when something needs attention. Set up in about five minutes. Free to start.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={REGISTER_URL} class="btn-primary px-6 py-3 text-base">Start free</a>
        <a href="/docs/getting-started" class="btn-outline px-6 py-3 text-base">See how it works</a>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">No credit card needed.</p>
      <div class="card mx-auto mt-12 max-w-2xl p-4 text-left shadow-md">
        <p class="text-xs font-medium text-muted-foreground">One command on your server</p>
        <pre class="code mt-2 overflow-x-auto" tabindex="0">curl -fsSL https://get.yuktiops.com | sudo bash -s -- --key=yk_live_…</pre>
      </div>
    </div>
  </section>

  <section class="section border-t bg-muted/40" aria-labelledby="how">
    <div class="wrap">
      <h2 id="how" class="text-center text-3xl font-bold tracking-tight">How it works</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {steps.map(([n, t, d]) => (
          <li class="card p-6">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-foreground" aria-hidden="true">{n}</span>
            <h3 class="mt-4 text-lg font-semibold"><span class="sr-only">Step {n}: </span>{t}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="features">
    <div class="wrap">
      <h2 id="features" class="text-center text-3xl font-bold tracking-tight">Everything you need, nothing you do not</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-muted-foreground">Built for founders and small teams who want to be told when something is wrong, without learning a monitoring tool.</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {features.map(([t, d]) => (
          <div class="card p-6"><h3 class="font-semibold">{t}</h3><p class="mt-2 text-sm text-muted-foreground">{d}</p></div>
        ))}
      </div>
      <p class="mt-8 text-center"><a href="/features" class="font-medium underline underline-offset-4">See all features</a></p>
    </div>
  </section>

  <section class="section border-t bg-muted/40" aria-labelledby="alongside">
    <div class="wrap grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 id="alongside" class="text-3xl font-bold tracking-tight">Works alongside Datadog, Prometheus and Netdata</h2>
        <p class="mt-4 text-muted-foreground">Already have a monitoring tool? Keep it. YuktiOps is an independent watchdog. If your own monitoring runs on the same server that just crashed, it cannot tell you. We can, because our checks run on our side.</p>
        <p class="mt-4 text-muted-foreground">Our agent does not open ports and does not share ports or exporters with your other tools, so it does not get in their way.</p>
      </div>
      <div class="card p-6">
        <h3 class="font-semibold">Our promise to your server</h3>
        <ul class="mt-4 space-y-3">
          {promises.map(([t, d]) => <li class="text-sm"><span class="font-medium">{t}.</span> <span class="text-muted-foreground">{d}</span></li>)}
        </ul>
        <p class="mt-4 text-sm"><a href="/security" class="font-medium underline underline-offset-4">Read exactly what the agent collects</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pricing">
    <div class="wrap text-center">
      <h2 id="pricing" class="text-3xl font-bold tracking-tight">Simple, affordable pricing</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted-foreground">Start free with 2 servers and 5 website checks. Paid plans start at ₹599 or $9 a month.</p>
      <p class="mt-6"><a href="/pricing" class="btn-outline">See pricing</a></p>
    </div>
  </section>

  <Cta />
</Base>
