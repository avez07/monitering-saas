# Local development values only. Copy to .env before starting. Never commit .env.
NODE_ENV=development
PORT=4000
FRONTEND_PORT=5173
# Production: https://app.yuktiops.com and https://api.yuktiops.com (https is required).
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# Which proxies to trust for client IPs (Express "trust proxy"). Use "loopback" behind Caddy/Nginx on the same host.
TRUST_PROXY=loopback
POSTGRES_USER=yuktiops
POSTGRES_PASSWORD=yuktiops_local_dummy
POSTGRES_DB=yuktiops
DATABASE_URL=postgresql://yuktiops:yuktiops_local_dummy@localhost:5432/yuktiops?schema=public
# Integration tests run against this database (created automatically by `npm test`).
TEST_DATABASE_URL=postgresql://yuktiops:yuktiops_local_dummy@localhost:5432/yuktiops_test?schema=public
# Redis is required (docker compose up -d redis). Tests use TEST_REDIS_URL (a different DB index; it is flushed).
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1
# OpenTelemetry storage (docker compose up -d clickhouse). Tests create and drop their own database.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=yuktiops
CLICKHOUSE_PASSWORD=yuktiops_local_dummy
CLICKHOUSE_DATABASE=yuktiops_otel
# Prometheus remote_write storage for the premium dashboard (docker compose up -d victoriametrics).
VM_URL=http://localhost:8428
# Active series per organization per hour before /v1/prom/write answers 429.
# PROM_MAX_SERIES_PER_ORG=50000
# Largest OTLP request body (after gunzip) and queue limit before the API answers 503.
# OTEL_MAX_BODY_BYTES=4194304
# OTEL_MAX_WAITING=2000
# Optional PgBouncer (docker compose --profile pgbouncer up -d pgbouncer): point the app at it, keep migrations direct, e.g.
# DATABASE_URL=postgresql://yuktiops:yuktiops_local_dummy@localhost:6432/yuktiops?schema=public&pgbouncer=true&connection_limit=10
# Internal /metrics: with no token only direct loopback connections may read it. Bull Board (/admin/queues) is off unless both are set.
# METRICS_TOKEN=
# BULL_BOARD_USER=
# BULL_BOARD_PASSWORD=
BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=local-dummy-billing-webhook-secret
# Dev only: allow /api/billing/change to switch plans without payment. Must be false in production.
BILLING_DEV_MODE=true
# Payments (see docs/billing-setup.md). Leave empty until you have accounts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON map of plan id to provider price ids, one line.
BILLING_PRICE_MAP={}
COMPANY_GSTIN=
COMPANY_STATE=
EMAIL_PROVIDER=local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@yuktiops.com
WORKER_INTERVAL_MS=30000
# Set by the agent after enrolling (see START.md).
AGENT_NAME=local-development-host
