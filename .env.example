# Local development values only. Copy to .env before starting. Never commit .env.
NODE_ENV=development
PORT=4000
FRONTEND_PORT=5173
# Production: https://app.yuktiops.com and https://api.yuktiops.com (https is required).
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# Which proxies to trust for client IPs (Express "trust proxy"). Use "loopback" behind Caddy/Nginx on the same host.
TRUST_PROXY=loopback
POSTGRES_USER=yuktiops
POSTGRES_PASSWORD=yuktiops_local_dummy
POSTGRES_DB=yuktiops
DATABASE_URL=postgresql://yuktiops:yuktiops_local_dummy@localhost:5432/yuktiops?schema=public
# Integration tests run against this database (created automatically by `npm test`).
TEST_DATABASE_URL=postgresql://yuktiops:yuktiops_local_dummy@localhost:5432/yuktiops_test?schema=public
BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=local-dummy-billing-webhook-secret
EMAIL_PROVIDER=local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@yuktiops.com
WORKER_INTERVAL_MS=30000
# Set by the agent after enrolling (see START.md).
AGENT_NAME=local-development-host
