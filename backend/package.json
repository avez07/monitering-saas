{
  "name": "@yuktiops/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node scripts/test-db.mjs && node --test --test-concurrency=1 test/*.test.js",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:validate": "node scripts/validate-schema.mjs",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "ch:migrate": "node clickhouse/run.mjs",
    "admin:create": "node scripts/admin.mjs create",
    "admin:revoke": "node scripts/admin.mjs revoke"
  },
  "dependencies": {
    "@clickhouse/client": "1.25.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^6.7.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.1.2",
    "protobufjs": "8.8.1",
    "rate-limiter-flexible": "^11.5.0",
    "snappyjs": "0.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "supertest": "^7.1.4"
  }
}
