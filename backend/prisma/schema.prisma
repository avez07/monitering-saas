generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(uuid())
  name         String
  email        String               @unique
  passwordHash String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganizationMember[]
  auditLogs    AuditLog[]
  sessions     Session[]
}

model Organization {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  settings             Json                  @default("{}")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  members              OrganizationMember[]
  projects             Project[]
  subscription         Subscription?
  billingCustomer      BillingCustomer?
  alertIncidents       AlertIncident[]
  auditLogs            AuditLog[]
  invoices             Invoice[]
  notificationChannels NotificationChannel[]
  apiKeys              ApiKey[]
  agentConfigs         AgentConfig[]
  payments             Payment[]
  uptimeChecks         UptimeCheck[]
  webhookEvents        WebhookEvent[]
}

model OrganizationMember {
  id           String       @id @default(uuid())
  orgId        String
  userId       String
  role         String
  projectIds   String[]     @default([])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Project {
  id             String              @id @default(uuid())
  orgId          String
  name           String
  slug           String
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  environments   Environment[]
  resources      MonitoredResource[]
  agents         Agent[]
  credentials    AgentCredential[]
  alertRules     AlertRule[]
  uptimeMonitors UptimeMonitor[]

  @@unique([orgId, slug])
  @@unique([orgId, id])
}

model Environment {
  id        String   @id @default(uuid())
  orgId     String
  projectId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, projectId, name])
}

model MonitoredResource {
  id          String          @id @default(uuid())
  orgId       String
  projectId   String
  agentId     String?
  externalId  String?
  name        String
  type        String
  environment String
  status      String
  labels      Json            @default("{}")
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  agent       Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  incidents   AlertIncident[]

  @@unique([orgId, externalId])
  @@index([orgId, projectId, type, environment])
}

model Agent {
  id          String              @id @default(uuid())
  orgId       String
  projectId   String
  name        String
  platform    String
  version     String
  status      String
  lastSeen    DateTime
  /// SHA-256 of the machine id, so reinstalling on the same machine reconnects the same server.
  fingerprint String?
  os          String              @default("")
  arch        String              @default("")
  configId    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  credentials AgentCredential[]
  resources   MonitoredResource[]
  events      AgentEvent[]

  @@unique([orgId, fingerprint])
  @@index([orgId, projectId, status])
}

model AgentCredential {
  id        String    @id @default(uuid())
  orgId     String
  projectId String
  agentId   String?
  name      String
  kind      String
  prefix    String
  tokenHash String    @unique
  revokedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([orgId, projectId, kind])
}

/// The one account key that registers any number of servers. Only a hash is stored; shown once.
/// The migration adds a partial unique index so an organization has at most one active key.
model ApiKey {
  id           String       @id @default(uuid())
  orgId        String
  name         String       @default("Account key")
  prefix       String
  tokenHash    String       @unique
  createdById  String
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, revokedAt])
}

/// A setup profile ("st_...") the agent pulls. Settings only toggle built-in, read-only collectors.
/// The migration adds a partial unique index so an organization has at most one default profile.
model AgentConfig {
  id           String       @id
  orgId        String
  name         String
  isDefault    Boolean      @default(false)
  version      Int          @default(1)
  settings     Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Install progress, errors the agent reports, and problems we detect, for the connection page.
model AgentEvent {
  id          String   @id @default(uuid())
  orgId       String
  agentId     String?
  fingerprint String?
  source      String
  code        String
  message     String   @default("")
  details     Json     @default("{}")
  createdAt   DateTime @default(now())
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([orgId, fingerprint, createdAt])
}

/// A TimescaleDB hypertable (created in the migration): one row per agent per sample.
model ServerMetric {
  time          DateTime @db.Timestamptz(6)
  agentId       String   @map("agent_id")
  orgId         String   @map("org_id")
  cpuPercent    Float?   @map("cpu_percent")
  memPercent    Float?   @map("mem_percent")
  swapPercent   Float?   @map("swap_percent")
  diskPercent   Float?   @map("disk_percent")
  load1         Float?
  load5         Float?
  load15        Float?
  netRxBps      Float?   @map("net_rx_bps")
  netTxBps      Float?   @map("net_tx_bps")
  diskReadBps   Float?   @map("disk_read_bps")
  diskWriteBps  Float?   @map("disk_write_bps")
  uptimeSeconds Float?   @map("uptime_seconds")
  /// Per-mount, per-interface and top-process detail.
  details       Json?

  @@id([agentId, time])
  @@map("server_metrics")
}

model SubscriptionPlan {
  id                      String         @id
  name                    String
  priceUsdCents           Int
  priceInrPaise           Int
  includedServers         Int
  extraServerUsdCents     Int
  extraServerInrPaise     Int
  monitors                Int
  minCheckIntervalSeconds Int
  members                 Int
  alertRules              Int
  retentionDays           Int
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  subscriptions           Subscription[]
}

model Subscription {
  id                String           @id @default(uuid())
  orgId             String           @unique
  planId            String
  status            String
  interval          String
  periodEnd         DateTime
  cancelAtPeriodEnd Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
}

model BillingCustomer {
  id           String       @id @default(uuid())
  orgId        String       @unique
  provider     String
  providerId   String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           String       @id @default(uuid())
  orgId        String
  number       String       @unique
  amount       Int
  currency     String
  status       String
  provider     String
  periodStart  DateTime
  periodEnd    DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
}

model Payment {
  id           String       @id @default(uuid())
  orgId        String
  providerId   String       @unique
  provider     String
  amount       Int
  currency     String
  status       String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
}

model AlertRule {
  id              String          @id @default(uuid())
  orgId           String
  projectId       String
  name            String
  metric          String
  operator        String
  threshold       Float
  durationSeconds Int
  cooldownSeconds Int
  enabled         Boolean         @default(true)
  severity        String
  silenceUntil    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  project         Project         @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  incidents       AlertIncident[]

  @@index([orgId, projectId, enabled])
}

model AlertIncident {
  id             String                 @id @default(uuid())
  orgId          String
  projectId      String
  ruleId         String
  resourceId     String
  name           String
  severity       String
  state          String
  value          Float
  startedAt      DateTime
  resolvedAt     DateTime?
  lastNotifiedAt DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  rule           AlertRule              @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  resource       MonitoredResource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  deliveries     NotificationDelivery[]
  organization   Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, projectId, state])
}

model NotificationChannel {
  id           String                 @id @default(uuid())
  orgId        String
  name         String
  type         String
  address      String
  enabled      Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deliveries   NotificationDelivery[]
  organization Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model NotificationDelivery {
  id            String              @id @default(uuid())
  orgId         String
  incidentId    String
  channelId     String
  address       String
  subject       String
  body          String
  status        String
  attempts      Int                 @default(0)
  nextAttemptAt DateTime
  deliveredAt   DateTime?
  error         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  incident      AlertIncident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel       NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([orgId, status, nextAttemptAt])
}

model AuditLog {
  id           String       @id @default(uuid())
  orgId        String
  userId       String
  action       String
  target       String
  details      Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
}

model WebhookEvent {
  id           String       @id
  orgId        String
  type         String
  payload      Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
}

model UptimeMonitor {
  id                   String        @id @default(uuid())
  orgId                String
  projectId            String
  name                 String
  target               String
  intervalSeconds      Int
  failureThreshold     Int
  consecutiveFailures  Int           @default(0)
  enabled              Boolean       @default(true)
  status               String
  latencyMs            Float?
  lastCheckedAt        DateTime?
  nextCheckAt          DateTime?
  certificateExpiresAt DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  project              Project       @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  checks               UptimeCheck[]

  @@index([orgId, projectId, enabled])
}

model UptimeCheck {
  id                   String        @id @default(uuid())
  orgId                String
  monitorId            String
  ok                   Boolean
  statusCode           Int
  latencyMs            Float
  certificateExpiresAt DateTime?
  error                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  monitor              UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  organization         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, monitorId, createdAt])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String    @default("")
  ip         String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkerLease {
  id        String   @id
  holder    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
