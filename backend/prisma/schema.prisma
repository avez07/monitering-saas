generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(uuid())
  name            String
  email           String               @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  memberships     OrganizationMember[]
  auditLogs       AuditLog[]
  sessions        Session[]
  accountTokens   AccountToken[]
}

/// Single-use, hashed tokens for email verification and password reset.
model AccountToken {
  id        String    @id @default(uuid())
  userId    String
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// A pending or finished invitation to join an organization. Only the token hash is stored.
model Invite {
  id           String       @id @default(uuid())
  orgId        String
  email        String
  role         String
  tokenHash    String       @unique
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
}

model Organization {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  settings             Json                  @default("{}")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  members              OrganizationMember[]
  projects             Project[]
  subscription         Subscription?
  billingCustomer      BillingCustomer?
  billingProfile       BillingProfile?
  alertIncidents       AlertIncident[]
  auditLogs            AuditLog[]
  invoices             Invoice[]
  notificationChannels NotificationChannel[]
  apiKeys              ApiKey[]
  telemetrySettings    TelemetrySettings?
  agentConfigs         AgentConfig[]
  payments             Payment[]
  uptimeChecks         UptimeCheck[]
  webhookEvents        WebhookEvent[]
  invites              Invite[]
}

model OrganizationMember {
  id           String       @id @default(uuid())
  orgId        String
  userId       String
  role         String
  /// Deprecated and unused since the 3-role model (owner/admin/viewer). Kept to avoid a destructive migration.
  projectIds   String[]     @default([])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Project {
  id             String              @id @default(uuid())
  orgId          String
  name           String
  slug           String
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  environments   Environment[]
  resources      MonitoredResource[]
  agents         Agent[]
  credentials    AgentCredential[]
  alertRules     AlertRule[]
  uptimeMonitors UptimeMonitor[]

  @@unique([orgId, slug])
  @@unique([orgId, id])
}

model Environment {
  id        String   @id @default(uuid())
  orgId     String
  projectId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, projectId, name])
}

model MonitoredResource {
  id          String          @id @default(uuid())
  orgId       String
  projectId   String
  agentId     String?
  externalId  String?
  name        String
  type        String
  environment String
  status      String
  labels      Json            @default("{}")
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  agent       Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  incidents   AlertIncident[]

  @@unique([orgId, externalId])
  @@index([orgId, projectId, type, environment])
}

model Agent {
  id          String              @id @default(uuid())
  orgId       String
  projectId   String
  name        String
  platform    String
  version     String
  status      String
  lastSeen    DateTime
  /// SHA-256 of the machine id, so reinstalling on the same machine reconnects the same server.
  fingerprint String?
  os          String              @default("")
  arch        String              @default("")
  configId    String?
  /// server | docker-host (from the setup profile's hostKind)
  kind        String              @default("server")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  credentials AgentCredential[]
  resources   MonitoredResource[]
  events      AgentEvent[]

  @@unique([orgId, fingerprint])
  @@index([orgId, projectId, status])
}

model AgentCredential {
  id        String    @id @default(uuid())
  orgId     String
  projectId String
  agentId   String?
  name      String
  kind      String
  prefix    String
  tokenHash String    @unique
  revokedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([orgId, projectId, kind])
}

/// The one account key that registers any number of servers. Only a hash is stored; shown once.
/// The migration adds a partial unique index so an organization has at most one active key.
model ApiKey {
  id           String       @id @default(uuid())
  orgId        String
  name         String       @default("Account key")
  /// "install" (yk_live_..., registers servers) or "telemetry" (yk_otel_..., write-only OTLP ingest).
  kind         String       @default("install")
  prefix       String
  tokenHash    String       @unique
  createdById  String
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, revokedAt])
  @@index([orgId, kind, revokedAt])
}

/// A setup profile ("st_...") the agent pulls. Settings only toggle built-in, read-only collectors.
/// The migration adds a partial unique index so an organization has at most one default profile.
model AgentConfig {
  id           String       @id
  orgId        String
  name         String
  isDefault    Boolean      @default(false)
  version      Int          @default(1)
  settings     Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Install progress, errors the agent reports, and problems we detect, for the connection page.
model AgentEvent {
  id          String   @id @default(uuid())
  orgId       String
  agentId     String?
  fingerprint String?
  source      String
  code        String
  message     String   @default("")
  details     Json     @default("{}")
  createdAt   DateTime @default(now())
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([orgId, fingerprint, createdAt])
}

/// A TimescaleDB hypertable (created in the migration): one row per agent per sample.
model ServerMetric {
  time          DateTime @db.Timestamptz(6)
  agentId       String   @map("agent_id")
  orgId         String   @map("org_id")
  cpuPercent    Float?   @map("cpu_percent")
  memPercent    Float?   @map("mem_percent")
  swapPercent   Float?   @map("swap_percent")
  diskPercent   Float?   @map("disk_percent")
  load1         Float?
  load5         Float?
  load15        Float?
  netRxBps      Float?   @map("net_rx_bps")
  netTxBps      Float?   @map("net_tx_bps")
  diskReadBps   Float?   @map("disk_read_bps")
  diskWriteBps  Float?   @map("disk_write_bps")
  uptimeSeconds Float?   @map("uptime_seconds")
  /// Per-mount, per-interface and top-process detail.
  details       Json?

  @@id([agentId, time])
  @@map("server_metrics")
}

model SubscriptionPlan {
  id                      String         @id
  name                    String
  priceUsdCents           Int
  priceInrPaise           Int
  includedServers         Int
  extraServerUsdCents     Int
  extraServerInrPaise     Int
  monitors                Int
  minCheckIntervalSeconds Int
  members                 Int
  alertRules              Int
  retentionDays           Int
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  subscriptions           Subscription[]
}

model Subscription {
  id                     String           @id @default(uuid())
  orgId                  String           @unique
  planId                 String
  status                 String
  interval               String
  periodEnd              DateTime
  cancelAtPeriodEnd      Boolean          @default(false)
  /// Payment provider ("stripe" | "razorpay") and its subscription id; null on Free.
  provider               String?
  providerSubscriptionId String?          @unique
  currency               String?
  /// When the first unpaid invoice failed; the 7-day grace period counts from here.
  pastDueSince           DateTime?
  /// Provider timestamp of the newest event applied, so out-of-order webhooks never roll state back.
  providerEventAt        DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  organization           Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan @relation(fields: [planId], references: [id])
}

model BillingCustomer {
  id           String       @id @default(uuid())
  orgId        String       @unique
  provider     String
  providerId   String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String       @id @default(uuid())
  orgId         String
  number        String       @unique
  amount        Int
  currency      String
  status        String
  provider      String
  periodStart   DateTime
  periodEnd     DateTime
  /// Amount before tax, tax amount and tax rate (GST 0.18 for INR); `amount` is the total charged.
  subtotal      Int?
  tax           Int          @default(0)
  taxRate       Float        @default(0)
  taxBreakdown  Json?
  customerGstin String?
  url           String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
}

/// Who we invoice: legal name, address and (for India) the optional GSTIN.
model BillingProfile {
  id           String       @id @default(uuid())
  orgId        String       @unique
  legalName    String       @default("")
  email        String       @default("")
  country      String       @default("")
  state        String       @default("")
  gstin        String       @default("")
  address      String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String       @id @default(uuid())
  orgId          String
  providerId     String       @unique
  provider       String
  amount         Int
  refundedAmount Int          @default(0)
  currency       String
  status         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
}

model AlertRule {
  id              String          @id @default(uuid())
  orgId           String
  projectId       String
  name            String
  metric          String
  operator        String
  threshold       Float
  durationSeconds Int
  cooldownSeconds Int
  enabled         Boolean         @default(true)
  severity        String
  silenceUntil    DateTime?
  /// Plain-language rule fields (templates, scope, routing). "all" or "selected".
  scopeType       String          @default("all")
  scopeIds        String[]        @default([])
  /// Empty means "all enabled contacts".
  contactIds      String[]        @default([])
  templateKey     String?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  project         Project         @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  incidents       AlertIncident[]

  @@index([orgId, projectId, enabled])
}

model AlertIncident {
  id             String                 @id @default(uuid())
  orgId          String
  projectId      String
  ruleId         String
  resourceId     String
  name           String
  severity       String
  state          String
  value          Float
  startedAt      DateTime
  resolvedAt     DateTime?
  lastNotifiedAt DateTime?
  acknowledgedAt DateTime?
  /// When the condition first looked clear again; the incident resolves after it stays clear (flap protection).
  clearSince     DateTime?
  /// True once a "firing" notification was queued, so recovery is only announced for alerts users saw.
  notified       Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  rule           AlertRule              @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  resource       MonitoredResource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  deliveries     NotificationDelivery[]
  organization   Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, projectId, state])
  @@index([ruleId, resourceId, state])
}

model NotificationChannel {
  id            String                 @id @default(uuid())
  orgId         String
  name          String
  type          String
  address       String
  enabled       Boolean                @default(true)
  /// Webhook contacts: HMAC signing secret. Never returned after creation.
  secret        String?
  /// Display details such as the linked Telegram chat name.
  meta          Json                   @default("{}")
  /// Telegram link flow: SHA-256 of the one-time code, valid until linkExpiresAt.
  linkCodeHash  String?                @unique
  linkExpiresAt DateTime?
  lastTestAt    DateTime?
  lastTestOk    Boolean?
  lastTestError String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deliveries    NotificationDelivery[]
  organization  Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model NotificationDelivery {
  id            String              @id @default(uuid())
  orgId         String
  incidentId    String
  channelId     String
  address       String
  subject       String
  body          String
  status        String
  attempts      Int                 @default(0)
  nextAttemptAt DateTime
  deliveredAt   DateTime?
  error         String?
  /// Structured payload for webhook contacts.
  payload       Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  incident      AlertIncident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel       NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([orgId, status, nextAttemptAt])
}

model AuditLog {
  id           String       @id @default(uuid())
  orgId        String
  userId       String
  action       String
  target       String
  details      Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
}

model WebhookEvent {
  id           String        @id
  orgId        String?
  provider     String        @default("mock")
  eventId      String?
  type         String
  payload      Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([provider, eventId])
  @@index([orgId, createdAt])
}

model UptimeMonitor {
  id                   String        @id @default(uuid())
  orgId                String
  projectId            String
  name                 String
  target               String
  intervalSeconds      Int
  failureThreshold     Int
  consecutiveFailures  Int           @default(0)
  enabled              Boolean       @default(true)
  status               String
  latencyMs            Float?
  lastCheckedAt        DateTime?
  nextCheckAt          DateTime?
  certificateExpiresAt DateTime?
  /// http | keyword | api | tcp
  type                 String        @default("http")
  method               String        @default("GET")
  headers              Json          @default("{}")
  body                 String?
  expectedStatus       Int?
  keyword              String?
  keywordMode          String        @default("present")
  jsonContains         String?
  timeoutSeconds       Int           @default(10)
  lastError            String?
  downSince            DateTime?
  domain               String?
  domainExpiresAt      DateTime?
  domainCheckedAt      DateTime?
  /// ok | unsupported | error
  domainStatus         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  project              Project       @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  checks               UptimeCheck[]

  @@index([orgId, projectId, enabled])
}

model UptimeCheck {
  id                   String        @id @default(uuid())
  orgId                String
  monitorId            String
  ok                   Boolean
  statusCode           Int
  latencyMs            Float
  certificateExpiresAt DateTime?
  error                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  monitor              UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  organization         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, monitorId, createdAt])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String    @default("")
  ip         String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Phase 11: current state of one Docker container on one server (identified by its name).
model ContainerItem {
  id              String    @id @default(uuid())
  orgId           String
  agentId         String
  dockerId        String    @default("")
  name            String
  image           String    @default("")
  /// running | restarting | paused | stopped | removed
  state           String
  rawState        String    @default("")
  status          String    @default("")
  restartCount    Int       @default(0)
  cpuPercent      Float?
  memoryBytes     Float?
  memoryLimitBytes Float?
  startedAt       DateTime?
  /// True once the container has been seen running; a "stopped" alert needs it.
  wasRunning      Boolean   @default(false)
  /// Consecutive snapshots in which the container was present and not running.
  stoppedStreak   Int       @default(0)
  firstSeen       DateTime  @default(now())
  lastSeen        DateTime  @default(now())
  /// The agent's snapshot time that last updated this row (makes retries harmless).
  reportedAt      DateTime  @default(now())
  stateChangedAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([agentId, name])
  @@index([orgId, state])
}

/// Phase 12: current state of one monitored service (systemd unit, process, port, nginx...) on one server.
model ServiceItem {
  id             String   @id @default(uuid())
  orgId          String
  agentId        String
  name           String
  /// systemd | process | port | nginx | apache | mysql | postgres | redis
  kind           String
  /// running | stopped | failed | unknown
  state          String
  detail         String   @default("")
  responseMs     Float?
  port           Int?
  stoppedStreak  Int      @default(0)
  firstSeen      DateTime @default(now())
  lastSeen       DateTime @default(now())
  reportedAt     DateTime @default(now())
  stateChangedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([agentId, kind, name])
  @@index([orgId, state])
}

/// State-change history for containers and services.
model StateEvent {
  id          String   @id @default(uuid())
  orgId       String
  agentId     String
  /// container | service
  subjectType String
  subjectId   String
  subjectName String
  /// appeared | started | stopped | restarted | oom | removed | failed | recovered
  type        String
  message     String   @default("")
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
  @@index([agentId, createdAt])
}

/// A TimescaleDB hypertable (created in the migration): one row per container per ingest.
model ContainerMetric {
  time             DateTime @db.Timestamptz(6)
  containerId      String   @map("container_id")
  agentId          String   @map("agent_id")
  orgId            String   @map("org_id")
  cpuPercent       Float?   @map("cpu_percent")
  memoryBytes      Float?   @map("memory_bytes")
  memoryLimitBytes Float?   @map("memory_limit_bytes")
  restartCount     Int?     @map("restart_count")

  @@id([containerId, time])
  @@map("container_metrics")
}

/// Per-organization OpenTelemetry settings: redaction rules and sampling (retention follows the plan,
/// usage lives in Redis counters). One row per organization, created on first save.
model TelemetrySettings {
  orgId        String       @id
  redaction    Json         @default("[]")
  sampling     Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}
