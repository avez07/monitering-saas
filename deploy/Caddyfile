# YuktiOps edge. Domains and ACME email come from the environment (see .env.production.example):
#   APP_DOMAIN=app.yuktiops.com  API_DOMAIN=api.yuktiops.com  ACME_EMAIL=ops@yuktiops.com
#
# Client IPs: by default Caddy talks to browsers/agents directly, so it sets X-Forwarded-For to the real
# peer address and the API trusts only Caddy (TRUST_PROXY = the "edge" subnet in docker-compose.prod.yml).
# If you put Cloudflare's proxy (orange cloud) in front, uncomment the "servers" block below, fill in
# Cloudflare's published ranges (https://www.cloudflare.com/ips-v4 and /ips-v6) and enable authenticated
# origin pulls (docs/ops.md section 5) so nobody else can spoof CF-Connecting-IP.
{
	email {$ACME_EMAIL}
	# servers {
	# 	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 ...
	# 	client_ip_headers CF-Connecting-IP
	# }
}

# The API runs as 2+ replicas (docker-compose.prod.yml "api"). Docker DNS returns one A record per running
# replica; "dynamic a" re-resolves every 5 s so scaling and rolling restarts are picked up without a reload.
# Connection failures are retried on another replica (lb_try_*), and a replica that fails is skipped for
# fail_duration (passive health). Containers marked unhealthy by Docker are replaced by compose.
# NOTE: /metrics and /admin/* are internal. They are answered with 404 at the edge and never proxied.
(api_upstream) {
	reverse_proxy {
		dynamic a {
			name api
			port 4000
			refresh 5s
			dial_timeout 2s
		}
		lb_policy least_conn
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 2
		unhealthy_status 502 503 504
		unhealthy_latency 20s
		{block}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

# Browser app: static frontend, same-origin /api (session cookie) and /v1, SPA fallback to index.html.
{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip

	@internal path /metrics /metrics/* /admin /admin/*
	handle @internal {
		respond 404
	}

	@backend path /api/* /v1/* /downloads/*
	handle @backend {
		import api_upstream
	}

	handle {
		root * /srv/app
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	request_body /api/* {
		max_size 256KB
	}
	log {
		output stdout
		format json
	}
}

# Agent endpoint + health checks. Agents send gzip bodies; the API enforces its own limits.
{$API_DOMAIN} {
	import security_headers
	encode zstd gzip

	@internal path /metrics /metrics/* /admin /admin/*
	respond @internal 404

	request_body {
		max_size 1MB
	}
	import api_upstream {
		transport http {
			response_header_timeout 30s
		}
	}
	log {
		output stdout
		format json
	}
}

# OpenTelemetry ingest (Phase 18): customers point OTEL_EXPORTER_OTLP_ENDPOINT here. Only the three OTLP/HTTP
# paths are proxied; everything else is 404, so the agent API and dashboard API are not reachable on this host.
# OTLP_DOMAIN=otlp.yuktiops.com. (gRPC on :4317 is not offered yet.)
{$OTLP_DOMAIN} {
	import security_headers
	encode zstd gzip

	@otlp path /v1/traces /v1/logs /v1/metrics
	handle @otlp {
		request_body {
			max_size 5MB
		}
		import api_upstream {
			transport http {
				response_header_timeout 30s
			}
		}
	}
	handle {
		respond 404
	}
	log {
		output stdout
		format json
	}
}
